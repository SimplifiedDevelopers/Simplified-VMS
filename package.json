{
  "name": "ssm-vms",
  "version": "2.5.0",
  "description": "Unified multi-vendor VMS desktop client (Hikvision, Dahua, TVT, Uniview)",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Simplified Developers",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:hik-native": "npm run build --prefix native/hikvision",
    "build:unv-native": "npm run build --prefix native/uniview",
    "build:dahua-native": "npm run build --prefix native/dahua",
    "build:tvt-native": "npm run build --prefix native/tvt",
    "dist:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "node-addon-api": "^8.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "node-gyp": "^10.2.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
